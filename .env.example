# FullScale environment variables.
# Copy to .env (gitignored) and fill in. Don't commit your filled .env.
# Categories: REQUIRED to boot · REQUIRED for production · OPTIONAL features.

# ─── REQUIRED to boot ─────────────────────────────────────────────────────────

# Postgres connection. Use a local docker postgres or a Neon/Supabase dev DB.
# Drizzle config reads from this for `npm run db:push`.
DATABASE_URL=postgresql://postgres:password@localhost:5432/fullscale_dev

# Encryption key for OAuth tokens stored in social_accounts.access_token.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Session signing secret for express-session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Node env. "development" enables Vite middleware + verbose logging.
NODE_ENV=development

# HTTP port for the express server. Default 5000.
PORT=5000

# ─── REQUIRED for video scanning + harmonization ──────────────────────────────

# Google Gemini API key — surface detection in scanner_v2.ts.
# Get one at https://aistudio.google.com/apikey
AI_INTEGRATIONS_GEMINI_API_KEY=

# Optional: custom Gemini base URL if proxying. Leave blank for Google default.
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Anthropic API key — narrative analysis + Claude Dense (autoRemix scan mode).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# fal.ai key — TRELLIS 3D, IC-Light v2 relighting, Depth Anything v2,
# birefnet background removal. Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# ─── REQUIRED for production deploy on Replit ─────────────────────────────────

# Replit-managed Object Storage (GCS-backed). Bucket ID from the Replit panel.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Replit OAuth (only used when deployed on Replit's auth-managed env).
REPLIT_CONNECTORS_HOSTNAME=
REPL_ID=
REPL_IDENTITY=
ISSUER_URL=
WEB_REPL_RENEWAL=

# Production app URL — used in OAuth redirect URIs.
BASE_URL=https://gofullscale.co

# Cookie scope for cross-subdomain auth. Leave blank for localhost dev.
COOKIE_DOMAIN=

# ─── Google OAuth (login) ─────────────────────────────────────────────────────

# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include $BASE_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Facebook / Instagram (creator content import) ────────────────────────────

# https://developers.facebook.com — Meta for Developers, create an app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Twitch (optional creator platform) ───────────────────────────────────────

# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── Distribution publishing (scheduled posts to platforms) ───────────────────
# Full setup guide: docs/DISTRIBUTION_TOKENS.md
# YouTube uses the Google OAuth creds above (youtube.upload scope).
# Instagram uses the Facebook app above (instagram_content_publish scope).

# TikTok developer app — https://developers.tiktok.com (Login Kit + Content
# Posting API products). Redirect URI: $BASE_URL/auth/tiktok/callback
# Unaudited apps can only post with privacy SELF_ONLY.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X developer app — https://developer.x.com (OAuth 2.0, type Web App,
# scopes tweet.read tweet.write users.read media.write offline.access).
# Redirect URI: $BASE_URL/auth/twitter/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn app — https://developer.linkedin.com (products: "Sign In with
# LinkedIn using OpenID Connect" + "Share on LinkedIn").
# Redirect URI: $BASE_URL/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Scheduler controls (see server/lib/distribution/scheduler.ts)
# SCHEDULER_ENABLED=false disables the publishing scheduler entirely.
SCHEDULER_ENABLED=
# Posts past their slot by more than this many hours are failed, not published.
SCHEDULER_MISFIRE_GRACE_HOURS=
# "true" runs the whole publish pipeline but logs instead of calling platforms.
PUBLISH_DRY_RUN=

# ─── Stripe (creator subscriptions) ───────────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# ─── Optional / feature-gated ─────────────────────────────────────────────────

# OpenAI — fallback for some transcript/categorization paths.
OPENAI_API_KEY=

# Deepgram — audio transcription pipeline.
DEEPGRAM_API_KEY=

# ElevenLabs — voice synthesis for clip generation.
ELEVENLABS_VOICE_ID=

# Modelslab — alternate AI image gen path.
MODELSLAB_API_KEY=

# Airtable — signup ledger sync.
AIRTABLE_API_TOKEN=

# Cron jobs — secret token for scheduled task auth.
CRON_SECRET=

# Override default DB URL with a separate one (e.g. for migrations vs runtime).
DATABASE_URL_OVERRIDE=

# Skip IC-Light in the 3D harmonize pipeline. Set "true" if relighting is
# making product output worse on a particular category.
HARMONIZE_DISABLE_ICLIGHT=
